# Saida de build (PyInstaller e Arduino IDE) -- gerada a partir do codigo-
# fonte, nao precisa ficar versionada. Os .exe de release vao anexados
# direto na Release do GitHub, nao no repositorio.
build/
dist/
__pycache__/
*.pyc

# arquivos de lock/temporarios do SolidWorks
~$*.SLDPRT
~$*.SLDASM

# backups pessoais de configuracao exportados pela aba Geral do app --
# dados locais do usuario, nao codigo-fonte, nao deveriam ir pro repo
OrbePC_config_backup.json
firmware_cache/
